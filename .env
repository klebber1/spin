# ============================================================================
# Copie este arquivo para ".env" (uso local) ou, no Render, cadastre cada
# uma dessas variáveis em: Dashboard do serviço > Environment > Add Environment Variable
# ============================================================================
PORT=3000
# Token da sua conta PagBank (Minha Conta > Integrações > Tokens de API)
PAGBANK_TOKEN= 4c6d0c81-78a4-4165-966f-268a8b5cb3a9bdb6c7534bd4b64f969859566f46394713d7-5301-4d78-8e24-ca093ecd15df

# "sandbox" para testar, "production" quando for cobrar de verdade
PAGBANK_AMBIENTE=sandbox

# URL pública deste servidor depois de implantado no Render
# (ex: https://spin-checkout.onrender.com)
MEU_DOMINIO= https://alongside-exploring-mural.ngrok-free.dev

# URL da sua landing page para onde o cliente volta após pagar
URL_RETORNO_CLIENTE=https://alongside-exploring-mural.ngrok-free.dev/index.html#pago

# Preço do serviço em reais (ex: 97.00)
VALOR_PRODUTO_REAIS=97.00

# Nome do produto/serviço exibido na tela de pagamento do PagBank
NOME_PRODUTO=Emissão de Nota Fiscal - Spin Tecnologia

# ===== COBRANÇA RECORRENTE (MENSALIDADE) =====
# "true" para cobrar todo mês automaticamente, "false" para cobrança única
RECORRENCIA_ATIVA=true

# Nome do plano exibido no painel de recorrência do PagBank
NOME_PLANO_RECORRENTE=Plano Mensal - Spin Tecnologia

# Intervalo entre cobranças (MONTH = mês, YEAR = ano) e sua duração
INTERVALO_UNIDADE=MONTH
INTERVALO_DURACAO=1

# Número de cobranças até a assinatura expirar sozinha.
# Deixe em branco para cobrar para sempre, até o cliente cancelar.
CICLOS_COBRANCA=

# (Opcional) Webhook (Make/Zapier/n8n) para onde repassar cada cobrança
# mensal confirmada (evento subscription.recurrence)
WEBHOOK_COBRANCA_RECORRENTE=

# (Opcional) Webhook (Make/Zapier/n8n) para onde repassar a confirmação de
# pagamento real, depois de validada. Deixe em branco se não for usar.
WEBHOOK_PAGAMENTO_CONFIRMADO=
